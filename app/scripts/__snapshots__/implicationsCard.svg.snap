<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="675" viewBox="0 0 1200 675">
  <defs>
    <linearGradient id="bg" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#faf8f5"/>
      <stop offset="100%" stop-color="#f3f0eb"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bg)"/>

  <!-- Header -->
  <text x="48" y="45" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="28" font-weight="700" fill="#1a1815">
    Nigeria
  </text>
  <text x="48" y="75" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="18" font-weight="500" fill="#5c574f">
    What convergence means by 2045
  </text>

  <!-- Implication Cards -->
  
  <g transform="translate(240, 130)">
    <rect width="720" height="210" rx="16" fill="#fffffe" stroke="#e5e0d8"/>

    <!-- Icon circle -->
    <circle cx="40" cy="40" r="28" fill="#f59e0b" fill-opacity="0.15"/>
    <text x="40" y="50" text-anchor="middle" font-size="28">⚡</text>

    <!-- Title -->
    <text x="80" y="35" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="700" fill="#8a847a" letter-spacing="0.8">ELECTRICITY BUILDOUT</text>

    <!-- Value -->
    
    <text x="24" y="100" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="32" font-weight="800" fill="#1a1815">+320 TWh</text>
    

    <!-- Subtitle -->
    
    <text x="24" y="140" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="14" fill="#5c574f">≈22 nuclear plants</text>
    

    <text x="24" y="170" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="12" fill="#8a847a">
      Additional annual electricity required by 2045
    </text>

    <!-- Accent bar (bottom rounded corners via clip-path) -->
    <defs>
      <clipPath id="accentClip0">
        <rect x="0" y="194" width="720" height="32" rx="16"/>
      </clipPath>
    </defs>
    <rect x="0" y="204" width="720" height="6" fill="#f59e0b" fill-opacity="0.6" clip-path="url(#accentClip0)"/>
  </g>
  

  <!-- GDP Summary -->
  <g transform="translate(240, 368)">
    <rect width="720" height="80" rx="12" fill="#fffffe" stroke="#e5e0d8"/>

    <!-- GDP Icon -->
    <circle cx="50" cy="40" r="24" fill="#8b5cf6" fill-opacity="0.15"/>
    <text x="50" y="48" text-anchor="middle" font-size="22">💰</text>

    <!-- GDP Label -->
    <text x="90" y="30" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="700" fill="#8a847a" letter-spacing="0.8">GDP (TOTAL)</text>

    <!-- GDP Values -->
    
    <text x="90" y="55" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="24" font-weight="700" fill="#1a1815">$1.3T</text>
    <text x="250" y="55" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="18" fill="#5c574f">→</text>
    <text x="280" y="55" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="24" font-weight="700" fill="#8b5cf6">$4.9T</text>
    <text x="430" y="55" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="14" fill="#5c574f">by 2045</text>
    
  </g>

  <!-- Disclaimer -->
  <text x="600" y="476" text-anchor="middle" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#8a847a">
    Estimates based on template country development paths. Actual outcomes vary by policy and technology.
  </text>

  <!-- Footer -->
  <line x1="48" y1="625" x2="1152" y2="625" stroke="#e5e0d8" stroke-opacity="0.5"/>
  <text x="48" y="657" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="13" fill="#8a847a">convergence.example.com</text>
  <text x="1152" y="657" text-anchor="end" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#8a847a">Data: World Bank</text>
</svg>