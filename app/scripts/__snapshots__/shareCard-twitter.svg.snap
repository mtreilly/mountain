<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="675" viewBox="0 0 1200 675">
  <defs>
    <linearGradient id="bg" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#faf8f5"/>
      <stop offset="100%" stop-color="#f3f0eb"/>
    </linearGradient>
    <linearGradient id="chartBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fffffe" stop-opacity="0.6"/>
      <stop offset="100%" stop-color="#fffffe" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="675" fill="url(#bg)"/>

  <!-- Header -->
  <text x="48" y="50" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="36" font-weight="800" fill="#1a1815">
    Nigeria → United States
  </text>
  <text x="48" y="78" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="16" font-weight="500" fill="#5c574f">
    GDP per capita (PPP) · constant 2021 int$
  </text>
  <text x="48" y="108" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="20" font-weight="600" fill="#8b5cf6">
    Nigeria catches United States in 97 years
  </text>

  <!-- Data source pill -->
  <g transform="translate(1020, 30)">
    <rect width="132" height="28" rx="14" fill="#fffffe" stroke="#e5e0d8"/>
    <text x="66" y="18" text-anchor="middle" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#5c574f">
      World Bank
    </text>
  </g>

  <!-- Chart area -->
  <rect x="48" y="130" width="1104" height="405" rx="12" fill="url(#chartBg)" stroke="#e5e0d8" stroke-opacity="0.5"/>

  
  <!-- Grid lines -->
  <g stroke="#e5e0d8" stroke-dasharray="3,3" stroke-opacity="0.6">
    <line x1="108" y1="495" x2="1092" y2="495"/>
    <line x1="108" y1="411.2482391073644" x2="1092" y2="411.2482391073644"/>
    <line x1="108" y1="327.50018535711956" x2="1092" y2="327.50018535711956"/>
    <line x1="108" y1="243.74842446448392" x2="1092" y2="243.74842446448392"/>
    <line x1="108" y1="160.00037071423912" x2="1092" y2="160.00037071423912"/>
  </g>

  <!-- Y-axis labels -->
  <g font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#8a847a">
    <text x="100" y="495" text-anchor="end" dominant-baseline="middle">$0</text>
    <text x="100" y="411.2482391073644" text-anchor="end" dominant-baseline="middle">$22.6K</text>
    <text x="100" y="327.50018535711956" text-anchor="end" dominant-baseline="middle">$45.2K</text>
    <text x="100" y="243.74842446448392" text-anchor="end" dominant-baseline="middle">$67.8K</text>
    <text x="100" y="160.00037071423912" text-anchor="end" dominant-baseline="middle">$90.4K</text>
  </g>

  <!-- X-axis labels -->
  <g font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#8a847a">
    <text x="108" y="513" text-anchor="middle">2023</text>
    <text x="366.9473684210526" y="513" text-anchor="middle">2028</text>
    <text x="625.8947368421052" y="513" text-anchor="middle">2033</text>
    <text x="884.8421052631579" y="513" text-anchor="middle">2038</text>
  </g>

  <!-- Convergence marker -->
  

  <!-- Target line (dashed) -->
  <path d="M 108.0 242.9 L 159.8 240.4 L 211.6 237.8 L 263.4 235.3 L 315.2 232.7 L 366.9 230.1 L 418.7 227.4 L 470.5 224.7 L 522.3 222.0 L 574.1 219.3 L 625.9 216.5 L 677.7 213.8 L 729.5 210.9 L 781.3 208.1 L 833.1 205.2 L 884.8 202.3 L 936.6 199.4 L 988.4 196.5 L 1040.2 193.5 L 1092.0 190.5" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="7,5"/>

  <!-- Chaser line (solid) -->
  <path d="M 108.0 475.0 L 159.8 474.4 L 211.6 473.8 L 263.4 473.1 L 315.2 472.5 L 366.9 471.8 L 418.7 471.1 L 470.5 470.4 L 522.3 469.6 L 574.1 468.9 L 625.9 468.1 L 677.7 467.3 L 729.5 466.5 L 781.3 465.6 L 833.1 464.7 L 884.8 463.8 L 936.6 462.9 L 988.4 461.9 L 1040.2 460.9 L 1092.0 459.9" fill="none" stroke="#ea580c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- End point dots -->
  
  <circle cx="1092" cy="459.8970687016481" r="5" fill="#ea580c"/>
  <circle cx="1092" cy="190.45454545454544" r="5" fill="#059669"/>
  

  <!-- Legend -->
  <g transform="translate(1100, 160)">
    <rect x="-4" y="-6" width="52" height="48" rx="6" fill="#fffffe" fill-opacity="0.9" stroke="#e5e0d8" stroke-opacity="0.5"/>
    <circle cx="6" cy="8" r="4" fill="#ea580c"/>
    <text x="16" y="12" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="500" fill="#5c574f">Niger…</text>
    <circle cx="6" cy="28" r="4" fill="#059669"/>
    <text x="16" y="32" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="500" fill="#5c574f">Unite…</text>
  </g>
  

  <!-- Stat cards -->
  <g transform="translate(48, 545)">
    
    <g transform="translate(0, 0)">
      <rect width="360" height="70" rx="10" fill="#fffffe" stroke="#e5e0d8"/>
      <text x="14" y="22" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="700" fill="#8a847a" letter-spacing="0.8">TIME TO CONVERGE</text>
      <text x="14" y="50" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="22" font-weight="700" fill="#1a1815">97 years</text>
    </g>
    
    <g transform="translate(372, 0)">
      <rect width="360" height="70" rx="10" fill="#fffffe" stroke="#e5e0d8"/>
      <text x="14" y="22" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="700" fill="#8a847a" letter-spacing="0.8">CURRENT GAP</text>
      <text x="14" y="50" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="22" font-weight="700" fill="#1a1815">12.6×</text>
    </g>
    
    <g transform="translate(744, 0)">
      <rect width="360" height="70" rx="10" fill="#fffffe" stroke="#e5e0d8"/>
      <text x="14" y="22" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="700" fill="#8a847a" letter-spacing="0.8">GROWTH RATES</text>
      <text x="14" y="50" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="22" font-weight="700" fill="#1a1815">3.0% / 1.0%</text>
    </g>
    
  </g>

  <!-- Footer -->
  <line x1="48" y1="625" x2="1152" y2="625" stroke="#e5e0d8" stroke-opacity="0.5"/>
  <text x="48" y="657" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="13" fill="#8a847a">convergence.example.com</text>
  <text x="1152" y="657" text-anchor="end" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#8a847a">Data: World Bank</text>
</svg>