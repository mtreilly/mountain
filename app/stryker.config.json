{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm test"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/lib/convergence.ts",
    "src/lib/implicationsMath.ts",
    "src/lib/shareState.ts",
    "src/lib/sensitivityAnalysis.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "concurrency": 2,
  "timeoutMS": 5000,
  "timeoutFactor": 1.2,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 60
  }
}
