{
  "name": "convergence-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "pnpm build && concurrently -k -n wrangler,vite -c blue,green \"pnpm pages:dev\" \"pnpm dev\"",
    "prepare": "cd .. && ./app/node_modules/.bin/husky app/.husky",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "typecheck": "tsc -b --pretty false --noEmit",
    "prepush:check": "pnpm lint:biome && pnpm typecheck && pnpm test",
    "test": "tsx scripts/test.ts && tsx scripts/snapshot.test.ts && tsx scripts/property.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:bench": "tsx scripts/bench.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry-run": "stryker run --dryRunOnly",
    "test:all": "pnpm test && pnpm test:components && pnpm test:e2e",
    "test:update-snapshots": "tsx scripts/snapshot.test.ts --update && playwright test --grep @visual --update-snapshots",
    "preview": "vite preview",
    "start": "pnpm build && wrangler pages dev dist --local --persist-to=.wrangler/state",
    "pages:dev": "wrangler pages dev dist --local --persist-to=.wrangler/state",
    "pages:deploy": "pnpm build && wrangler pages deploy dist",
    "db:init": "wrangler d1 execute convergence-db --local --file=./schema.sql",
    "db:import": "wrangler d1 execute convergence-db --local --file=./data-import-fixed.sql",
    "data:refresh": "pnpm data:fetch && pnpm db:import",
    "data:fetch": "tsx scripts/fetch-worldbank.ts > data-import.sql && tsx scripts/fetch-owid-co2.ts >> data-import.sql && tsx scripts/fetch-owid-energy.ts >> data-import.sql && tsx scripts/fetch-irena-capacity.ts >> data-import.sql && tsx scripts/fetch-ember-generation.ts >> data-import.sql && tsx scripts/fetch-ember-capacity.ts >> data-import.sql && echo 'DELETE FROM data_points;' | cat - data-import.sql > data-import-fixed.sql"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.3.14",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "wrangler": "^4.59.2"
  }
}
