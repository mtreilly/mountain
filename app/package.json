{
  "name": "convergence-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "pnpm build && concurrently -k -n wrangler,vite -c blue,green \"pnpm pages:dev\" \"pnpm dev\"",
    "prepare": "cd .. && ./app/node_modules/.bin/husky app/.husky",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "typecheck": "tsc -b --pretty false --noEmit",
    "prepush:check": "pnpm lint:biome && pnpm typecheck && pnpm test",
    "test": "tsx scripts/test.ts && tsx scripts/snapshot.test.ts && tsx scripts/property.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:bench": "tsx scripts/bench.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry-run": "stryker run --dryRunOnly",
    "test:all": "pnpm test && pnpm test:components && pnpm test:e2e",
    "test:update-snapshots": "tsx scripts/snapshot.test.ts --update && playwright test --grep @visual --update-snapshots",
    "preview": "vite preview",
    "start": "pnpm build && wrangler pages dev dist --local --persist-to=.wrangler/state",
    "pages:dev": "wrangler pages dev dist --local --persist-to=.wrangler/state",
    "pages:deploy": "pnpm build && wrangler pages deploy dist",
    "db:init": "wrangler d1 execute convergence-db --local --file=./schema.sql",
    "db:import": "wrangler d1 execute convergence-db --local --file=./data-import-fixed.sql",
    "data:refresh": "pnpm data:fetch && pnpm db:import",
    "data:fetch": "tsx scripts/fetch-worldbank.ts > data-import.sql && tsx scripts/fetch-pwt.ts >> data-import.sql && tsx scripts/fetch-owid-co2.ts >> data-import.sql && tsx scripts/fetch-owid-energy.ts >> data-import.sql && tsx scripts/fetch-irena-capacity.ts >> data-import.sql && tsx scripts/fetch-ember-generation.ts >> data-import.sql && tsx scripts/fetch-ember-capacity.ts >> data-import.sql && echo 'DELETE FROM data_points;' | cat - data-import.sql > data-import-fixed.sql"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "i18next": "^25.8.11",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "^2.3.14",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^9.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "read-excel-file": "^9.0.9",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.67.0"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "fast-uri@<3.1.2": "3.1.2",
      "flatted@<3.4.2": "3.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "picomatch@<4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.10",
      "qs@<6.14.2": "6.14.2",
      "rollup@<4.59.0": "4.59.0",
      "underscore@<1.13.8": "1.13.8",
      "undici@<7.24.0": "7.24.0"
    }
  }
}
